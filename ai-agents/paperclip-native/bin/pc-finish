#!/usr/bin/env python3
"""pc-finish: post the final comment and set the status of the current Paperclip issue.

Usage (inside a Paperclip run):
  pc-finish done --file /path/to/4_final.md   # posts the file + its folder path
  pc-finish done <<'EOF'
  final answer
  EOF
  pc-finish blocked "question for Rizzo"
"""
import json, os, sys, urllib.request, urllib.error

ALLOWED = {"done", "blocked"}
ENV = ("PAPERCLIP_API_URL", "PAPERCLIP_API_KEY", "PAPERCLIP_RUN_ID", "PAPERCLIP_TASK_ID")
USAGE = "usage: pc-finish done|blocked [--file PATH | comment]  (or comment via stdin)"

def fail(msg, code=2):
    print(msg, file=sys.stderr)
    return code

def main():
    args = sys.argv[1:]
    if not args or args[0] not in ALLOWED:
        return fail(USAGE)
    status = args[0]
    if len(args) >= 2 and args[1] == "--file":
        if len(args) != 3:
            return fail(USAGE)
        path = os.path.abspath(os.path.expanduser(args[2]))
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read().strip()
        except OSError as e:
            return fail(f"error: cannot read file: {e}")
        comment = f"{text}\n\nArquivos: {os.path.dirname(path)}" if text else ""
    elif len(args) > 1:
        comment = " ".join(args[1:]).strip()
    else:
        comment = sys.stdin.read().strip()
    if not comment:
        return fail("error: empty comment")
    missing = [v for v in ENV if not os.environ.get(v)]
    if missing:
        return fail("error: missing env: " + ", ".join(missing))
    api = os.environ["PAPERCLIP_API_URL"].rstrip("/")
    if not api.endswith("/api"):
        api += "/api"
    url = f"{api}/issues/{os.environ['PAPERCLIP_TASK_ID']}"
    data = json.dumps({"status": status, "comment": comment}).encode()
    req = urllib.request.Request(url, data=data, method="PATCH", headers={
        "Authorization": "Bearer " + os.environ["PAPERCLIP_API_KEY"],
        "X-Paperclip-Run-Id": os.environ["PAPERCLIP_RUN_ID"],
        "Content-Type": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print(f"OK: issue set to {status} (HTTP {r.status})")
            return 0
    except urllib.error.HTTPError as e:
        return fail(f"error: HTTP {e.code}: {e.read().decode(errors='replace')[:500]}", 1)
    except urllib.error.URLError as e:
        return fail(f"error: {e.reason}", 1)

if __name__ == "__main__":
    sys.exit(main())
