# Copie para .env e preencha. O .env nunca vai para o git.
MEM0_URL=http://127.0.0.1:8888
MEM0_USER_ID=rizzo
# Chave criada com: python3 ../mem0-server/mem0_admin.py create-key crewai <caminho do .env>
MEM0_API_KEY=
# true = servidor extrai fatos com LLM + entity linking (mais lento)
# false = grava o texto literal, sem LLM e sem entity linking
MEM0_INFER=true
